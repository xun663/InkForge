# InkForge environment variables (example).
# Copy to `.env` locally and fill in real values — `.env` is git-ignored, never commit it.
# Leave everything unset for the default Mock / InMemory experience (zero API key, zero Docker).

# --- LLM (continuation / memory extraction / rerank) ---
# provider: mock | deepseek | openai | ollama | openai-compatible   (default: mock)
INKFORGE_LLM_PROVIDER=
# model name, e.g. deepseek-chat / gpt-4o-mini / qwen3:14b
INKFORGE_LLM_MODEL=
# API base URL; /chat/completions is appended automatically
INKFORGE_LLM_BASE_URL=
# API key — only read from environment, never stored, never shown in the UI
INKFORGE_LLM_API_KEY=

# --- Embedding (semantic retrieval) ---
# provider: mock | openai-compatible | openai | siliconflow   (default: mock)
INKFORGE_EMBEDDING_PROVIDER=
# e.g. bge-m3
INKFORGE_EMBEDDING_MODEL=
INKFORGE_EMBEDDING_BASE_URL=
INKFORGE_EMBEDDING_API_KEY=

# --- Reranker ---
# passthrough (default, deterministic) | llm
INKFORGE_RERANKER=

# --- PostgreSQL (only for the "postgres" profile) ---
# docker compose up -d   then   ./mvnw spring-boot:run -Dspring-boot.run.profiles=postgres
POSTGRES_URL=jdbc:postgresql://localhost:5432/inkforge
POSTGRES_USER=inkforge
POSTGRES_PASSWORD=your-password-here
